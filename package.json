{
  "name": "manju-studio",
  "version": "0.4.24",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-bundled-resources.mjs && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "mcp": "node scripts/agent-mcp.mjs",
    "agent": "node scripts/agent-cli.mjs",
    "publish:update": "node scripts/publish-update.mjs",
    "deploy:update": "node scripts/deploy-update-relay.mjs",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node scripts/build-bundled-resources.mjs && tsc -p tsconfig.server.json && node scripts/test.mjs",
    "test:concurrency-ui": "node scripts/test-concurrency-ui.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "test:smoke": "node scripts/smoke-source.mjs",
    "package:trial": "node scripts/package-clean-trial.mjs --no-vendor",
    "package:community": "node scripts/package-clean-trial.mjs --no-vendor --community",
    "package:installer": "node scripts/build-community-installer.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "Apache-2.0",
  "description": "万灵漫剧社区版：Windows 本机 AI 漫剧制作工作台",
  "repository": {
    "type": "git",
    "url": "https://github.com/jieg19274/wanling-manju-community.git"
  },
  "homepage": "https://github.com/jieg19274/wanling-manju-community",
  "bugs": {
    "url": "https://github.com/jieg19274/wanling-manju-community/issues"
  }
}
